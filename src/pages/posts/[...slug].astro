---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import {
  getPublishedPosts,
  postHref,
  categoryHref,
  tagHref,
  countChars,
  readingMinutes,
  type Post,
} from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts(); // 최신순
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, categories, tags, cover } = post.data;
// 목차는 h2·h3 만 — 템플릿 절(h2)과 소절(h3)
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
// 글 머리 정보 줄 — 작성일 · 글자 수 · 읽기 시간(레퍼런스 post-info 와 같은 셋)
const chars = countChars(post.body);
const minutes = readingMinutes(post, chars);
---

<Layout title={title} description={description} ogType="article">
  <div class="post-grid">
    <article class="post-card">
      <header class="post-head">
        <p class="eyebrow">{categories.map((c) => <a href={categoryHref(c)}>{c}</a>)}</p>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <ul class="post-info">
          <li>
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
              <rect x="3.5" y="5" width="17" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />
              <path d="M3.5 9.5h17M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            작성일: <FormattedDate date={pubDate} />
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
              <path d="M6 3h8l5 5v13H6z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
              <path d="M14 3v5h5M9 12h6M9 16h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            글자 수: <span class="num">{chars.toLocaleString('ko-KR')}</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
              <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.6" />
              <path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            읽기 시간: <span class="num">{minutes}</span> 분
          </li>
        </ul>
        {cover && <img class="cover" src={cover} alt="" decoding="async" />}
      </header>

      <div class="prose">
        <Content />
      </div>

      {
        tags.length > 0 && (
          <footer class="post-foot">
            <ul class="tags">
              {tags.map((t) => (
                <li>
                  <a href={tagHref(t)}>{t}</a>
                </li>
              ))}
            </ul>
          </footer>
        )
      }
    </article>

    {
      toc.length > 0 && (
        <aside class="toc" aria-label="목차">
          <nav class="toc-card">
            <p class="toc-title">목차</p>
            <ul>
              {toc.map((h) => (
                <li class:list={[{ sub: h.depth === 3 }]}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>

  {
    toc.length > 0 && (
      <button class="toc-btn" aria-label="목차 접기/펴기" aria-pressed="false">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            d="M9 6h11M9 12h11M9 18h11"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
          />
          <circle cx="4.5" cy="6" r="1.4" fill="currentColor" />
          <circle cx="4.5" cy="12" r="1.4" fill="currentColor" />
          <circle cx="4.5" cy="18" r="1.4" fill="currentColor" />
        </svg>
      </button>
    )
  }

  {
    (newer || older) && (
      <nav class="siblings" aria-label="이웃 글">
        <div>
          {older && (
            <a href={postHref(older)} rel="prev">
              <span class="label">이전 글</span>
              <span class="name">{older.data.title}</span>
            </a>
          )}
        </div>
        <div class="next">
          {newer && (
            <a href={postHref(newer)} rel="next">
              <span class="label">다음 글</span>
              <span class="name">{newer.data.title}</span>
            </a>
          )}
        </div>
      </nav>
    )
  }
</Layout>

<!-- 목차 스크롤스파이 — 뷰포트 상단 기준 지나간 마지막 표제를 활성화 -->
<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]'));
  const pairs: Array<[HTMLElement, HTMLAnchorElement]> = [];
  for (const a of links) {
    const el = document.getElementById(decodeURIComponent(a.hash.slice(1)));
    if (el) pairs.push([el, a]);
  }
  let active: HTMLAnchorElement | null = null;
  const pick = () => {
    let next: HTMLAnchorElement | null = pairs.length ? pairs[0][1] : null;
    for (const [el, a] of pairs) {
      if (el.getBoundingClientRect().top <= 120) next = a;
      else break;
    }
    if (next === active) return;
    active?.classList.remove('active');
    active = next;
    active?.classList.add('active');
  };
  if (pairs.length) {
    addEventListener('scroll', pick, { passive: true });
    addEventListener('resize', pick, { passive: true });
    pick();
  }

  // 목차 접기/펴기 — 접으면 글 카드가 전폭(레퍼런스와 같은 동작)
  const grid = document.querySelector('.post-grid');
  const tocBtn = document.querySelector('.toc-btn');
  tocBtn?.addEventListener('click', () => {
    const hidden = grid?.classList.toggle('toc-hidden') ?? false;
    tocBtn.setAttribute('aria-pressed', String(hidden));
  });
</script>

<style>
  /* 이 페이지에서만 — 겉 배경(레퍼런스 실측)과 본문 폭 확장 */
  :global(body) {
    background: var(--post-page-bg);
  }
  :global(main.wrap) {
    max-width: 76rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: 2rem;
    align-items: start;
    padding-block-start: 2rem;
  }

  /* 글 카드 — 흰 상자(레퍼런스 실측: 라운드 14px + 3중 그림자) */
  .post-card {
    background: var(--post-card-bg);
    border-radius: 14px;
    box-shadow: var(--post-card-shadow);
    padding: 1rem clamp(1.25rem, 4vw, 3rem) 3rem;
  }

  .post-head {
    padding-block: 2rem 2.5rem;
    max-width: var(--measure);
  }
  .post-head h1 {
    font-size: var(--text-2xl);
    margin-top: 0.75rem;
  }
  .lede {
    margin-top: 1rem;
    font-size: var(--text-lg);
    color: var(--fg-muted);
    line-height: 1.55;
  }
  /* 정보 줄 — 작성일 · 글자 수 · 읽기 시간 */
  .post-info {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--fg-muted);
  }
  .post-info li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }
  .post-info .num {
    font-variant-numeric: tabular-nums;
  }
  .cover {
    margin-top: 2rem;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--surface);
  }
  .post-foot {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }

  /* 우측 목차 — 스크롤해도 따라오는 카드 */
  .toc {
    position: sticky;
    top: 2rem;
    padding-block-start: 1rem;
  }
  .toc-card {
    background: var(--post-card-bg);
    border-radius: 14px;
    box-shadow: var(--toc-shadow);
    padding: 1.1rem 1rem 0.9rem;
    max-height: calc(100vh - 5rem);
    overflow: auto;
  }
  .toc-title {
    margin: 0 0 0.6rem;
    padding: 0 0.6rem 0.6rem;
    font-size: var(--text-sm);
    font-weight: 700;
    border-bottom: 1px solid var(--rule);
  }
  .toc-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc-card a {
    display: block;
    padding: 0.32rem 0.6rem;
    border-radius: 6px;
    font-size: var(--text-xs);
    line-height: 1.45;
    color: var(--fg-muted);
    text-decoration: none;
  }
  .toc-card li.sub a {
    padding-left: 1.5rem;
  }
  .toc-card a:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  .toc-card a.active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    font-weight: 600;
  }

  .siblings {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .siblings .next {
    text-align: right;
  }
  .siblings a {
    display: inline-block;
  }
  .siblings a:hover {
    text-decoration: none;
  }
  .siblings a:hover .name {
    color: var(--accent);
    text-decoration: underline;
  }
  .label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    margin-bottom: 0.25rem;
  }
  .name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
  }

  /* 목차 접기 — 버튼 토글로 글 카드 전폭 */
  .post-grid.toc-hidden {
    grid-template-columns: minmax(0, 1fr);
  }
  .post-grid.toc-hidden .toc {
    display: none;
  }
  /* 접힌 상태에선 본문 열을 카드 가운데로 — 오른쪽이 비어 보이지 않게 */
  .post-grid.toc-hidden :is(.post-head, .prose, .post-foot) {
    margin-inline: auto;
  }

  /* 접기/펴기 버튼 — 맨 위로 버튼(Layout .to-top) 바로 위에 같은 조형으로 */
  .toc-btn {
    position: fixed;
    right: clamp(1rem, 3vw, 2.25rem);
    bottom: calc(clamp(1rem, 3vw, 2.25rem) + 4rem);
    z-index: 6;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 12px;
    border: 0;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--accent-ink);
    cursor: pointer;
    box-shadow: 0 6px 20px -8px rgb(0 0 0 / 0.35);
  }
  .toc-btn:hover {
    filter: brightness(1.12);
  }
  .toc-btn[aria-pressed='true'] {
    background: var(--top-btn-bg);
    color: var(--top-btn-fg);
  }

  /* 목차를 놓을 폭이 없으면 목차·버튼 다 숨긴다(레퍼런스와 동일한 처리) */
  @media (max-width: 64rem) {
    .post-grid {
      grid-template-columns: 1fr;
    }
    .toc,
    .toc-btn {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .siblings {
      grid-template-columns: 1fr;
    }
    .siblings .next {
      text-align: left;
    }
  }
</style>
