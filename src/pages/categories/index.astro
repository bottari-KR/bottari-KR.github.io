---
// 카테고리 목록 — ruby-kim.github.io/categories 구조: 행마다 이름 + 글 수, 그 아래 그 카테고리에 쓰인 태그와 최신 글 제목.
import Layout from '../../layouts/Layout.astro';
import ListShell from '../../components/ListShell.astro';
import { getPublishedPosts, countCategories, categoryHref, tagHref, postHref } from '../../lib/posts';

const posts = await getPublishedPosts();
const categories = countCategories(posts).map(({ name, count }) => {
  const inCat = posts.filter((p) => p.data.categories.includes(name as never));
  const tags = [...new Set(inCat.flatMap((p) => p.data.tags))].slice(0, 6);
  return { name, count, tags, latest: inCat[0] };
});
---

<Layout title="카테고리" description="카테고리별 글 목록" hero>
  <ListShell title="카테고리" sub={`${categories.length}개 분류`}>
    <ul class="rows">
      {
        categories.map(({ name, count, tags, latest }) => (
          <li class="row">
            <div class="head">
              <a class="name" href={categoryHref(name)}>
                {name}
              </a>
              <span class="count">{count}</span>
            </div>
            {tags.length > 0 && (
              <ul class="subs">
                {tags.map((t) => (
                  <li>
                    <a href={tagHref(t)}>{t}</a>
                  </li>
                ))}
              </ul>
            )}
            <p class="latest">
              {latest ? <a href={postHref(latest)}>{latest.data.title}</a> : <span>아직 글이 없습니다.</span>}
            </p>
          </li>
        ))
      }
    </ul>
  </ListShell>
</Layout>

<style>
  .rows {
    list-style: none;
  }
  .row {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .row:first-child {
    padding-top: 0.25rem;
  }
  .row:last-child {
    border-bottom: 0;
    padding-bottom: 0.25rem;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .count {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--fg-muted);
  }
  .subs {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  .subs a::before {
    content: '#';
    color: var(--fg-faint);
  }
  .latest {
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  .latest a {
    text-decoration: underline;
    text-decoration-color: var(--rule);
  }
  .latest a:hover {
    text-decoration-color: var(--accent);
  }
</style>
