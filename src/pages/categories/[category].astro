---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES } from '../../site';
import { getPublishedPosts, postHref, type Post } from '../../lib/posts';

// 글이 없는 카테고리도 페이지를 만든다 — Categories 목록의 링크가 404 로 가지 않게.
export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return CATEGORIES.map((category) => ({
    params: { category },
    props: { category, posts: posts.filter((p) => p.data.categories.includes(category)) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  category: string;
  posts: Post[];
}

const { category, posts } = Astro.props;
---

<Layout title={category} description={`${category} 카테고리의 글`}>
  <header class="page-head">
    <p class="eyebrow"><a href="/categories/">Categories</a></p>
    <h1>{category}</h1>
  </header>
  {
    posts.length === 0 ? (
      <p class="empty">이 카테고리에는 아직 글이 없습니다.</p>
    ) : (
      <section aria-label={`${category} 글 목록`}>
        {posts.map((post) => (
          <PostCard
            href={postHref(post)}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            categories={post.data.categories}
            tags={post.data.tags}
            cover={post.data.cover}
          />
        ))}
      </section>
    )
  }
</Layout>

<style>
  .page-head h1 {
    margin-top: 0.5rem;
  }
</style>
