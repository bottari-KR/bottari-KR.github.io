---
import type { GetStaticPaths, Page } from 'astro';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { SITE } from '../site';
import { getPublishedPosts, postHref, type Post } from '../lib/posts';

// 홈 = 글 카드 목록. `/` 가 1쪽, `/2/` `/3/` … 이 다음 쪽.
export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: SITE.pageSize });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
const title = page.currentPage > 1 ? `${page.currentPage}쪽` : undefined;
---

<Layout title={title}>
  {/* 홈은 글 목록이 곧 히어로다. h1 은 접근성·검색용으로만 두고 시각적으로 숨긴다 — 사용자가 소개 문장을 정하면 그때 보이는 히어로로 올린다. */}
  <h1 class="sr-only">{SITE.description}</h1>

  {
    page.data.length === 0 ? (
      <p class="empty">아직 올린 글이 없습니다.</p>
    ) : (
      <section aria-label="글 목록" class="home-list">
        {page.data.map((post) => (
          <PostCard
            href={postHref(post)}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            categories={post.data.categories}
            tags={post.data.tags}
            cover={post.data.cover}
          />
        ))}
      </section>
    )
  }

  <Pagination current={page.currentPage} last={page.lastPage} prev={page.url.prev} next={page.url.next} />
</Layout>

<style>
  .home-list {
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    margin-top: 1.5rem;
  }
</style>
