---
import type { GetStaticPaths, Page } from 'astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { SITE } from '../site';
import { getPublishedPosts, postHref, type Post } from '../lib/posts';

// 홈 = 히어로(헤드라인) + 글 카드 목록. `/` 가 1쪽, `/2/` `/3/` … 이 다음 쪽(2쪽부터는 히어로 없이 목록만).
export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: SITE.pageSize });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
const first = page.currentPage === 1;
const title = first ? undefined : `${page.currentPage}쪽`;
---

<Layout title={title}>
  {first ? <Hero /> : <h1 class="sr-only">{SITE.description}</h1>}

  <div class:list={[{ 'after-hero': first }]}>
    {
      page.data.length === 0 ? (
        <p class="empty" id="posts">아직 올린 글이 없습니다.</p>
      ) : (
        <section aria-labelledby="posts-heading" class="home-list" id="posts">
          {first ? <h2 class="eyebrow list-heading" id="posts-heading">최근 글</h2> : <h2 class="sr-only" id="posts-heading">글 목록</h2>}
          {page.data.map((post) => (
            <PostCard
              href={postHref(post)}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              categories={post.data.categories}
              tags={post.data.tags}
              cover={post.data.cover}
              headingLevel="h3"
            />
          ))}
        </section>
      )
    }

    <Pagination current={page.currentPage} last={page.lastPage} prev={page.url.prev} next={page.url.next} />
  </div>
</Layout>

<style>
  .home-list {
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    margin-top: 1.5rem;
  }
  .after-hero .home-list {
    border-top: 0;
    margin-top: 0;
    padding-top: 1rem;
  }
  .after-hero .empty,
  .after-hero .home-list {
    scroll-margin-top: 2rem;
  }
  .list-heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }
</style>
