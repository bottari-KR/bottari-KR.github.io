---
import Layout from '../../layouts/Layout.astro';
import { getPublishedPosts, countTags, tagHref } from '../../lib/posts';

const posts = await getPublishedPosts();
const tags = countTags(posts);
---

<Layout title="Tags" description="태그별 글 목록">
  <header class="page-head">
    <h1>Tags</h1>
  </header>
  {
    tags.length === 0 ? (
      <p class="empty">아직 태그가 없습니다.</p>
    ) : (
      <ul class="tags cloud">
        {tags.map(({ name, count }) => (
          <li>
            <a href={tagHref(name)}>{name}</a>
            <span class="count">{count}</span>
          </li>
        ))}
      </ul>
    )
  }
</Layout>

<style>
  .cloud {
    padding-top: 2rem;
    gap: 0.75rem 1.5rem;
    font-size: var(--text-base);
    max-width: var(--measure);
  }
  .count {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--fg-muted);
    margin-left: 0.25rem;
  }
</style>
