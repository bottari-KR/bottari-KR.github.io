---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../site';
// 본문은 사용자가 정한다 — 에이전트가 지어내지 않는다. 공개할 연락 수단만 아래 목록에 넣는다.
---

<Layout title="Contact" description={`${SITE.name} 연락처`}>
  <header class="page-head">
    <h1>Contact</h1>
  </header>
  <section class="prose">
    <ul>
      <li>GitHub — <a href={SITE.github} rel="me">{SITE.github.replace('https://', '')}</a></li>
    </ul>
  </section>
</Layout>

<style>
  section {
    padding-top: 2rem;
  }
</style>
