---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../site';
// 본문은 사용자가 정한다 — 에이전트가 지어내지 않는다. 확정된 문장을 받으면 아래 <section> 에 넣는다.
---

<Layout title="소개" description={`${SITE.name} 소개`}>
  <header class="page-head">
    <h1>소개</h1>
  </header>
  <section class="prose">
    <p>소개 글을 준비하고 있습니다.</p>
  </section>
</Layout>

<style>
  section {
    padding-top: 2rem;
  }
</style>
