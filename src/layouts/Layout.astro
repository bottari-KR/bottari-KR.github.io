---
import '../styles/global.css';
import { SITE, NAV } from '../site';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** 첫 화면이 전폭 히어로면 헤더를 그 위에 얹는다(색은 --hero-fg, main 은 wrap 없이 — 페이지가 직접 감싼다) */
  hero?: boolean;
}

const { title, description = SITE.description, ogType = 'website', hero = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const path = Astro.url.pathname;

// Home 은 라우트 패턴으로 판정한다 — `/`, `/2/`, `/3/` 은 전부 src/pages/[...page].astro 에서 나온다.
// (pathname 숫자 매칭은 `/404/` 도 잡아 404 페이지에서 Home 이 현재 페이지로 표시됐다.)
function isCurrent(href: string) {
  if (href === '/') return Astro.routePattern === '/[...page]';
  return path.startsWith(href);
}
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Pretendard Variable — 동적 서브셋(unicode-range 별 woff2). 페이지에 쓰인 글자 범위 파일만 내려받는다 */}
    <link rel="stylesheet" href="/fonts/pretendard/pretendardvariable-dynamic-subset.css" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121314" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class:list={[{ 'has-hero': hero }]}>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <header class:list={['site-header', 'wrap', { overlay: hero }]}>
      <a class="brand" href="/" aria-label={`${SITE.brand} 홈`}>
        {SITE.brand}<span class="emoji" aria-hidden="true">{SITE.brandEmoji}</span>
      </a>
      <nav aria-label="주 메뉴">
        <ul>
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="ext">
            <a href={SITE.github} rel="me">
              GitHub<span aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main id="main" class:list={[{ wrap: !hero }]}>
      <slot />
    </main>

    <footer class="site-footer wrap">
      <p>
        © {new Date().getFullYear()} {SITE.name}
        <span class="sep" aria-hidden="true">·</span>
        <a href={SITE.github} rel="me">GitHub</a>
      </p>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 0;
    top: 0;
    padding: 0.5rem 0.75rem;
    background: var(--accent);
    color: var(--accent-ink);
    transform: translateY(-120%);
    transition: transform var(--ease);
    z-index: 10;
  }
  .skip:focus-visible {
    transform: none;
    outline-offset: 0;
    border-radius: 0;
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.75rem 0.5rem;
  }

  .brand {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .brand:hover {
    color: var(--fg);
    text-decoration: none;
  }
  .emoji {
    margin-left: 0.3em;
    font-size: 0.9em;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  nav a[aria-current='page'] {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1.5px;
  }
  .ext a span {
    font-size: 0.75em;
    margin-left: 0.15em;
  }

  /* 좁은 화면 — 브랜드 한 줄, 메뉴는 그 아래 줄에서 감싼다 */
  @media (max-width: 40rem) {
    .site-header {
      gap: 0.5rem 1rem;
      padding-top: 1.25rem;
    }
    nav {
      flex: 1 1 100%;
      min-width: 0;
    }
    nav ul {
      gap: 0.25rem 1rem;
    }
  }

  /* 히어로 위에 얹힌 헤더 — 히어로 토큰 색, 배경·경계선 없음. 히어로 문구와 같은 왼쪽 선(--hero-inset).
     레퍼런스 첫 장의 맨 윗줄(작은 글자 한 줄)에 해당한다 */
  .site-header.overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
    color: var(--hero-fg);
    max-width: none;
    padding-inline: var(--hero-inset);
  }
  .site-header.overlay .brand,
  .site-header.overlay nav a[aria-current='page'] {
    color: var(--hero-fg);
  }
  .site-header.overlay nav ul {
    color: var(--hero-fg-muted);
  }
  .site-header.overlay .brand:hover {
    color: var(--hero-fg);
  }
  .site-header.overlay nav a:hover {
    color: var(--hero-fg);
    text-decoration-color: var(--hero-blob);
  }
  .site-header.overlay nav a[aria-current='page'] {
    text-decoration-color: var(--hero-blob);
  }
  .site-header.overlay :focus-visible {
    outline-color: var(--hero-fg);
  }

  main {
    min-height: 60vh;
    padding-bottom: 5rem;
  }
  .has-hero main {
    position: relative;
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    padding-block: 2rem 3rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  .site-footer a {
    /* 문장 속 링크 — 색만으로 구분하지 않는다 */
    text-decoration: underline;
    text-decoration-color: var(--fg-faint);
  }
  .sep {
    margin-inline: 0.5rem;
  }
</style>
