---
import '../styles/global.css';
import { SITE, NAV } from '../site';
import { CONTACT } from '../data/contact';
import NavIcon from '../components/NavIcon.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** 첫 화면이 전폭 히어로면 헤더를 그 위에 얹는다(색은 --hero-fg, main 은 wrap 없이 — 페이지가 직접 감싼다) */
  hero?: boolean;
}

const { title, description = SITE.description, ogType = 'website', hero = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const path = Astro.url.pathname;

// Home 은 라우트 패턴으로 판정한다 — `/`, `/2/`, `/3/` 은 전부 src/pages/[...page].astro 에서 나온다.
// (pathname 숫자 매칭은 `/404/` 도 잡아 404 페이지에서 Home 이 현재 페이지로 표시됐다.)
function isCurrent(href: string) {
  if (href === '/') return Astro.routePattern === '/[...page]';
  return path.startsWith(href);
}
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Pretendard Variable — 동적 서브셋(unicode-range 별 woff2). 페이지에 쓰인 글자 범위 파일만 내려받는다 */}
    <link rel="stylesheet" href="/fonts/pretendard/pretendardvariable-dynamic-subset.css" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121314" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class:list={[{ 'has-hero': hero }]}>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <header class:list={['site-header', 'wrap', { overlay: hero }]}>
      <a class="brand" href="/" aria-label={`${SITE.brand} 홈`}>
        <img class="brand-mark" src={SITE.brandMark} alt="" width="128" height="128" decoding="async" />
        {SITE.brand}
      </a>
      <nav aria-label="주 메뉴">
        <ul>
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  <NavIcon name={item.icon} />{item.label}
                </a>
              </li>
            ))
          }
          <li class="ext">
            <a href={SITE.github} rel="me">
              <NavIcon name="github" />깃허브<span aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main id="main" class:list={[{ wrap: !hero }]}>
      <slot />
    </main>

    <!-- 푸터 — 남색 전폭 띠(2026-09-01 사용자 요청, ruby-kim 푸터 구조 참고): 소개 · 메뉴 · 연결 + 저작권 줄 -->
    <footer class="site-footer">
      <div class="wrap cols">
        <div class="intro">
          <p class="name">{SITE.brand}</p>
          <p class="desc">{SITE.footerLine}</p>
        </div>
        <nav class="menu" aria-label="푸터 메뉴">
          <p class="hd" id="footer-menu-hd">메뉴</p>
          <ul aria-labelledby="footer-menu-hd">
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="links">
          <p class="hd">연결</p>
          <ul class="round">
            <li>
              <a href={SITE.github} rel="me" aria-label="GitHub"><NavIcon name="github" /></a>
            </li>
            <li>
              <a href={`mailto:${CONTACT.email}`} aria-label="이메일"><NavIcon name="mail" /></a>
            </li>
          </ul>
        </div>
      </div>
      <div class="wrap bottom">
        <p>© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>

    <!-- 맨 위로 — 스크롤하면 우하단에 나타난다 -->
    <button class="to-top" aria-label="맨 위로" hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M5 14.5 12 7.5 19 14.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <script>
      const btn = document.querySelector<HTMLButtonElement>('.to-top');
      if (btn) {
        const sync = () => {
          btn.hidden = scrollY < 480;
        };
        addEventListener('scroll', sync, { passive: true });
        sync();
        btn.addEventListener('click', () => {
          const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
          scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
        });
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 0;
    top: 0;
    padding: 0.5rem 0.75rem;
    background: var(--accent);
    color: var(--accent-ink);
    transform: translateY(-120%);
    transition: transform var(--ease);
    z-index: 10;
  }
  .skip:focus-visible {
    transform: none;
    outline-offset: 0;
    border-radius: 0;
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.75rem 0.5rem;
    /* 모든 페이지에서 같은 자리 — hero 페이지의 overlay 헤더와 같은 전폭·좌우 여백(--hero-inset).
       글 페이지만 .wrap 폭(60rem)이라 헤더가 안쪽으로 밀렸다(2026-09-02 사용자 지적, 레퍼런스는 전 페이지 동일) */
    max-width: none;
    padding-inline: var(--hero-inset);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .brand:hover {
    color: var(--fg);
    text-decoration: none;
  }
  /* 그림이 글자 앞 — 2026-08-28 사용자 요청(이모지 → 산타 사진, 순서는 그림 다음 글자) */
  .brand-mark {
    height: 1.5em;
    width: auto;
    user-select: none;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  nav a {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  nav a[aria-current='page'] {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1.5px;
  }
  .ext a span {
    font-size: 0.75em;
    margin-left: 0.15em;
  }

  /* 좁은 화면 — 브랜드 한 줄, 메뉴는 그 아래 줄에서 감싼다 */
  @media (max-width: 40rem) {
    .site-header {
      gap: 0.5rem 1rem;
      padding-top: 1.25rem;
    }
    nav {
      flex: 1 1 100%;
      min-width: 0;
    }
    nav ul {
      gap: 0.25rem 1rem;
    }
  }

  /* 히어로 위에 얹힌 헤더 — 히어로 토큰 색, 배경·경계선 없음. 히어로 문구와 같은 왼쪽 선(--hero-inset).
     레퍼런스 첫 장의 맨 윗줄(작은 글자 한 줄)에 해당한다 */
  .site-header.overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
    color: var(--hero-fg);
    max-width: none;
    padding-inline: var(--hero-inset);
  }
  .site-header.overlay .brand,
  .site-header.overlay nav a[aria-current='page'] {
    color: var(--hero-fg);
  }
  .site-header.overlay nav ul {
    color: var(--hero-fg-muted);
  }
  .site-header.overlay .brand:hover {
    color: var(--hero-fg);
  }
  .site-header.overlay nav a:hover {
    color: var(--hero-fg);
    text-decoration-color: var(--hero-blob);
  }
  .site-header.overlay nav a[aria-current='page'] {
    text-decoration-color: var(--hero-blob);
  }
  .site-header.overlay :focus-visible {
    outline-color: var(--hero-fg);
  }

  main {
    min-height: 60vh;
    padding-bottom: 5rem;
  }
  .has-hero main {
    position: relative;
    /* 히어로형 페이지는 섹션이 자체 여백을 가진다 — 종이색과 남색 푸터 사이 흰 띠가 안 생기게 */
    padding-bottom: 0;
  }

  .site-footer {
    background: var(--footer-bg);
    color: var(--footer-fg-muted);
    font-size: var(--text-sm);
  }
  .site-footer a {
    color: inherit;
  }
  .site-footer a:hover {
    color: var(--footer-fg);
    text-decoration: none;
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem 3rem;
    padding-block: 3.5rem 2.75rem;
  }
  .site-footer .name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--footer-fg);
  }
  .site-footer .desc {
    margin-top: 0.75rem;
    max-width: 32rem;
  }
  .hd {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
  }
  .site-footer ul {
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }
  .round {
    grid-auto-flow: column;
    justify-content: start;
    gap: 0.75rem;
  }
  .round a {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--footer-chip);
    color: var(--footer-fg);
  }
  .round a:hover {
    background: var(--footer-chip-hover);
  }
  .round :global(.nav-icon) {
    margin: 0;
    font-size: 1.15rem;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--footer-rule);
  }
  @media (max-width: 48rem) {
    .cols {
      grid-template-columns: 1fr;
      gap: 2.25rem;
      padding-block: 2.75rem 2.25rem;
    }
  }

  /* 맨 위로 버튼 — 우하단 고정, 스크롤 480px 넘으면 스크립트가 hidden 을 푼다 */
  .to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2.25rem);
    bottom: clamp(1rem, 3vw, 2.25rem);
    z-index: 6;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 12px;
    border: 0;
    display: grid;
    place-items: center;
    background: var(--top-btn-bg);
    color: var(--top-btn-fg);
    cursor: pointer;
    box-shadow: 0 6px 20px -8px rgb(0 0 0 / 0.35);
  }
  .to-top:hover {
    background: var(--top-btn-bg-hover);
  }
</style>
