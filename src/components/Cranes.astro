---
// 목록 페이지 패널(ListShell .panel) 위에 서 있는 두루미 — 2026-08-28 사용자 요청
// "카테고리·태그·아카이브·문의가 허전하다. 흰 박스 위에 조그맣게 4마리 정도 서 있는 느낌으로".
// 사용자가 준 레퍼런스(Pinterest 핀, 먹선 라인아트 단정학 — 흰 몸 · 검은 날개깃 · 붉은 정수리 · 가는 먹선)는
// 스타일만 빌렸다. 픽셀은 쓰지 않고 SVG 로 직접 그렸다(viewBox 100×128.5, 발끝이 아래 가장자리).
// <defs> 하나에 다리(둘·외발) · 몸통 · 머리(자세 셋: 서서 보기 · 땅 쪼기 · 깃 다듬기) · 날개(위·아래) · 나는 몸을 두고
// <use> 로 조합한다. 색은 global.css 의 --crane-* 토큰. 장식이라 aria-hidden.
// 페이지마다 마릿수·자리·자세가 다르다 — 같은 날 사용자 요청: 카테고리 4(그대로) · 태그 3 · 아카이브 5 · 문의 2, 자리는 전부 다르게.
// x 는 패널 왼쪽(side:'right' 면 오른쪽) 가장자리에서의 거리. 카테고리는 rem(왼쪽 셋 묶음, xm 은 좁은 화면용),
// 나머지는 패널 폭의 % 라 좁은 화면에서도 서로 안 겹친다(두루미 폭 ≤ 3.3rem, 폰 패널 ≈ 22rem).
// 마우스를 올리면(터치는 탭) 날개를 펴고 바라보는 쪽으로 날아갔다가 몇 초 뒤 반대쪽에서 돌아와 제자리에 앉는다 —
// 같은 날 사용자 요청. 아래 <script> 가 WAAPI 로 translate/rotate 를 움직이고 data-state 로 자세(stand/land/fly)를 바꾼다.
// prefers-reduced-motion 이면 날지 않는다.
type Pose = 'alert' | 'forage' | 'preen' | 'oneleg';
interface Crane {
  pose: Pose;
  x: string;
  xm?: string;
  side?: 'right';
  h: number;
  flip?: boolean;
}
const FLOCKS: Record<'categories' | 'tags' | 'archive' | 'contact', Crane[]> = {
  categories: [
    { pose: 'forage', x: '1.25rem', h: 0.86 },
    { pose: 'alert', x: '4.75rem', h: 1 },
    { pose: 'preen', x: '8.5rem', xm: '7.75rem', h: 0.92 },
    { pose: 'oneleg', x: '2rem', side: 'right', h: 1.04, flip: true },
  ],
  tags: [
    { pose: 'preen', x: '9%', h: 0.94 },
    { pose: 'oneleg', x: '41%', h: 1.02, flip: true },
    { pose: 'forage', x: '13%', side: 'right', h: 0.88 },
  ],
  archive: [
    { pose: 'alert', x: '3%', h: 1 },
    { pose: 'forage', x: '18%', h: 0.86, flip: true },
    { pose: 'preen', x: '46%', h: 0.92 },
    { pose: 'oneleg', x: '24%', side: 'right', h: 1.04, flip: true },
    { pose: 'alert', x: '5%', side: 'right', h: 0.9 },
  ],
  contact: [
    { pose: 'oneleg', x: '14%', h: 1 },
    { pose: 'preen', x: '10%', side: 'right', h: 0.9, flip: true },
  ],
};

interface Props {
  flock?: keyof typeof FLOCKS;
}

const { flock = 'categories' } = Astro.props;
const cranes = FLOCKS[flock];
---

<div class="flock" aria-hidden="true">
  <svg class="defs" width="0" height="0" focusable="false">
    <defs>
      <g id="crane-body">
        <path class="c-fill" d="M 27 68 C 30 56 46 52 60 55 C 74 58 86 64 89 71 C 84 82 68 88 52 86 C 38 84 26 80 27 68 Z"></path>
        <path class="c-ink" d="M 69 59 C 80 57 90 62 95 71 C 94 75 93 78 92 82 L 90.5 76 L 89.5 86 L 87 78 L 86 89 L 83.5 80 L 81.5 89 L 79.5 80 L 77 85 L 76 78 C 73.5 72 70 65 69 59 Z"></path>
        <path class="c-line" d="M 36 62 C 52 57 70 60 82 68"></path>
        <path class="c-line" d="M 42 68 C 54 65 66 67 78 74"></path>
        <path class="c-line" d="M 50 74 C 58 72 68 74 74 80"></path>
        <path class="c-line" d="M 58 80 C 63 79 68 81 71 84"></path>
      </g>
      <g id="crane-legs-2">
        <path class="c-leg" d="M 52 85 L 50 104 L 47 127"></path>
        <path class="c-leg" d="M 60 86 L 62 104 L 64 127"></path>
        <path class="c-toe" d="M 39 127.5 L 49.5 127.5"></path>
        <path class="c-toe" d="M 56 127.5 L 66.5 127.5"></path>
      </g>
      <g id="crane-legs-1">
        <path class="c-leg" d="M 56 86 L 55 106 L 55 127"></path>
        <path class="c-toe" d="M 47 127.5 L 57.5 127.5"></path>
        <path class="c-leg" d="M 61 86 L 69 96 L 61 100"></path>
      </g>
      <g id="crane-head-alert">
        <path class="c-body" d="M 28.3 64.6 C 22 54 24 38 30 26 C 32.5 21 34 16.5 35 12.5 L 41 11 C 40 16 38 21 34.5 26 C 29.5 38 28.5 50 34.3 58.3 L 31 66 Z"></path>
        <path class="c-line" d="M 28.3 64.6 C 22 54 24 38 30 26 C 32.5 21 34 16.5 35 12.5"></path>
        <path class="c-line" d="M 34.3 58.3 C 28.5 50 29.5 38 34.5 26 C 38 21 40 16 41 11"></path>
        <path class="c-fill" d="M 35 12.8 C 37 13.8 40 13.8 42 12.8 C 44 11.8 44.5 8.5 42.5 7 C 40.5 5.6 37 6 35 8.8 Z"></path>
        <path class="c-crown" d="M 35 8.9 C 37 5.9 41 5.5 43 7.4 C 41 7 38 7.6 35 8.9 Z"></path>
        <path class="c-ink" d="M 35 8.8 L 21 13.8 L 35 12.8 Z"></path>
        <circle class="c-ink" cx="38.3" cy="10.2" r="0.8"></circle>
      </g>
      <g id="crane-head-forage">
        <path class="c-body" d="M 28.3 64.6 C 18 62 8 72 6 84 C 5 92 5 100 6 105 L 12 103.5 C 11 96 11 88 12 78 C 14 64 26 56 34.3 58.3 L 31 66 Z"></path>
        <path class="c-line" d="M 28.3 64.6 C 18 62 8 72 6 84 C 5 92 5 100 6 105"></path>
        <path class="c-line" d="M 34.3 58.3 C 26 56 14 64 12 78 C 11 88 11 96 12 103.5"></path>
        <path class="c-fill" d="M 5.5 108.5 C 5 105 6.5 102.8 9.5 102.8 C 12.5 102.8 14.5 105 14 111 L 7.5 113 C 6 111.5 5.5 110 5.5 108.5 Z"></path>
        <path class="c-crown" d="M 11.5 103 C 13.8 104.2 14.8 107.5 14.2 110.5 C 13.8 107.5 13 105 11.5 103 Z"></path>
        <path class="c-ink" d="M 14 111 L 9.8 127 L 7.5 113 Z"></path>
        <circle class="c-ink" cx="9.5" cy="107.5" r="0.8"></circle>
      </g>
      <g id="crane-head-preen">
        <path class="c-body" d="M 28.3 64.6 C 22 52 24 34 36 30 C 46 27 52 30 54 36 L 52 41 C 50 36 46 34 40 36 C 31 40 30 50 34.3 58.3 L 31 66 Z"></path>
        <path class="c-line" d="M 28.3 64.6 C 22 52 24 34 36 30 C 46 27 52 30 54 36"></path>
        <path class="c-line" d="M 34.3 58.3 C 30 50 31 40 40 36 C 46 34 50 36 52 41"></path>
        <path class="c-fill" d="M 52 41 C 51.5 37.5 54 34.5 58 35 C 62 35.5 64.5 39 63.5 44 L 58.5 47.5 C 55 48 52.5 45 52 41 Z"></path>
        <path class="c-crown" d="M 57 34.9 C 61 35 64 38 64 42 C 62.5 39 60 36.5 57 34.9 Z"></path>
        <path class="c-ink" d="M 63.5 44 L 70 57 L 58.5 47.5 Z"></path>
        <circle class="c-ink" cx="59" cy="40" r="0.8"></circle>
      </g>
      <!-- 날개: 어깨(46,58) 기준. up = 등 위로 펼침, down = 배 아래로 내림. 끝 1/3 은 검은 깃 -->
      <g id="crane-wing-up">
        <path class="c-fill" d="M 46 58 C 40 44 50 24 70 12 C 74 22 68 38 62 48 C 60 52 58 56 62 59 Z"></path>
        <path class="c-ink" d="M 70 12 C 72 18 71 26 68 34 L 66 30 L 66 38 L 64 33 L 63 42 L 61 36 C 65 28 68 20 70 12 Z"></path>
        <path class="c-line" d="M 50 50 C 56 38 62 28 68 18"></path>
        <path class="c-line" d="M 54 54 C 58 44 62 36 66 26"></path>
      </g>
      <g id="crane-wing-down">
        <path class="c-fill" d="M 46 60 C 40 74 50 96 70 112 C 74 102 68 86 62 74 C 60 70 58 66 62 62 Z"></path>
        <path class="c-ink" d="M 70 112 C 72 106 71 98 68 90 L 66 94 L 66 86 L 64 91 L 63 82 L 61 88 C 65 96 68 104 70 112 Z"></path>
        <path class="c-line" d="M 50 68 C 56 80 62 90 68 104"></path>
        <path class="c-line" d="M 54 64 C 58 76 62 84 66 96"></path>
      </g>
      <!-- 나는 몸: 몸통 수평, 목 앞으로, 다리 뒤로 -->
      <g id="crane-flybody">
        <path class="c-leg" d="M 64 72 L 80 79 L 96 82"></path>
        <path class="c-leg" d="M 60 73 L 78 82 L 94 86"></path>
        <path class="c-fill" d="M 30 60 C 36 52 58 51 70 57 C 76 60 78 66 74 70 C 62 76 40 75 30 68 Z"></path>
        <path class="c-ink" d="M 68 56 C 78 55 88 58 93 64 L 91 68 L 89 63 L 88 70 L 86 65 L 83 71 L 81 65 L 78 69 L 77 64 C 74 62 71 60 68 56 Z"></path>
        <path class="c-body" d="M 31 66 C 24 64 16 60 10 57 L 15 51.5 C 20 52 26 55 32 58 L 34 62 Z"></path>
        <path class="c-line" d="M 31 66 C 24 64 16 60 10 57"></path>
        <path class="c-line" d="M 32 58 C 26 55 20 52 15 51.5"></path>
        <path class="c-fill" d="M 9.5 57 C 11 58.8 14.5 58.8 16.5 57 C 18.5 55 18.3 51.5 16 50 C 13.5 48.6 10 49.4 9 52 Z"></path>
        <path class="c-crown" d="M 9.2 51.8 C 11 49 14.5 48.8 16.3 50.5 C 14 50.2 11.5 50.6 9.2 51.8 Z"></path>
        <path class="c-ink" d="M 9 52 L 1 55.5 L 9.5 57 Z"></path>
        <circle class="c-ink" cx="12.5" cy="53.5" r="0.8"></circle>
      </g>
      <symbol id="crane-alert" viewBox="0 0 100 128.5"><use href="#crane-legs-2"></use><use href="#crane-body"></use><use href="#crane-head-alert"></use></symbol>
      <symbol id="crane-forage" viewBox="0 0 100 128.5"><use href="#crane-legs-2"></use><use href="#crane-body"></use><use href="#crane-head-forage"></use></symbol>
      <symbol id="crane-preen" viewBox="0 0 100 128.5"><use href="#crane-legs-2"></use><use href="#crane-body"></use><use href="#crane-head-preen"></use></symbol>
      <symbol id="crane-oneleg" viewBox="0 0 100 128.5"><use href="#crane-legs-1"></use><use href="#crane-body"></use><use href="#crane-head-alert"></use></symbol>
      <symbol id="crane-fly-up" viewBox="0 0 100 128.5">
        <use href="#crane-wing-up" transform="translate(-7 3) scale(0.92)"></use>
        <use href="#crane-flybody"></use>
        <use href="#crane-wing-up"></use>
      </symbol>
      <symbol id="crane-fly-down" viewBox="0 0 100 128.5">
        <use href="#crane-wing-down" transform="translate(-7 -3) scale(0.92)"></use>
        <use href="#crane-flybody"></use>
        <use href="#crane-wing-down"></use>
      </symbol>
      <!-- 이륙·착지: 선 자세에 날개만 위로 -->
      <symbol id="crane-land" viewBox="0 0 100 128.5">
        <use href="#crane-wing-up" transform="translate(-7 3) scale(0.92)"></use>
        <use href="#crane-legs-2"></use>
        <use href="#crane-body"></use>
        <use href="#crane-head-alert"></use>
        <use href="#crane-wing-up"></use>
      </symbol>
    </defs>
  </svg>

  {
    cranes.map((c) => (
      <svg
        class:list={['crane', { right: c.side === 'right', flip: c.flip }]}
        style={`--x:${c.x};--h:${c.h}${c.xm ? `;--xm:${c.xm}` : ''}`}
        data-face={c.flip ? '1' : '-1'}
      >
        <use class="u-stand" href={`#crane-${c.pose}`} />
        <use class="u-land" href="#crane-land" />
        <use class="u-fly u-fly-up" href="#crane-fly-up" />
        <use class="u-fly u-fly-down" href="#crane-fly-down" />
      </svg>
    ))
  }
</div>

<script>
  // 두루미 비행: pointerenter → 이륙(날개 위) → 바라보는 쪽으로 날아감 → 잠시 사라짐 → 반대쪽 위에서 돌아와 착지.
  // 자세는 data-state(land/fly), 이동은 WAAPI translate/rotate(.flip 은 scale 이라 합성된다 — transform 아님).
  const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  async function fly(el: SVGSVGElement) {
    if (REDUCED || el.dataset.state) return;
    const face = Number(el.dataset.face) || -1; // -1 = 왼쪽을 본다(기본), 1 = 오른쪽(거울)
    el.dataset.state = 'land';
    await wait(150);
    el.dataset.state = 'fly';
    const out = el.animate(
      [
        { translate: '0 0', rotate: '0deg' },
        { translate: `${face * 14}vw -14vh`, rotate: `${face * 14}deg`, offset: 0.4 },
        { translate: `${face * 60}vw -80vh`, rotate: `${face * 8}deg` },
      ],
      { duration: 1500, easing: 'cubic-bezier(0.45, 0, 0.85, 0.45)', fill: 'forwards' },
    );
    await out.finished;
    el.style.visibility = 'hidden';
    await wait(2400);
    el.style.visibility = '';
    const back = el.animate(
      [
        { translate: `${-face * 60}vw -70vh`, rotate: `${-face * 5}deg` },
        { translate: `${-face * 14}vw -16vh`, rotate: `${-face * 7}deg`, offset: 0.7 },
        { translate: '0 0', rotate: '0deg' },
      ],
      { duration: 1700, easing: 'cubic-bezier(0.2, 0.6, 0.3, 1)', fill: 'forwards' },
    );
    setTimeout(() => (el.dataset.state = 'land'), 1300);
    await back.finished;
    out.cancel();
    back.cancel();
    await wait(180);
    // 커서가 아직 제자리 위에 있으면 착지하자마자 다시 뜨지 않게 — 커서가 떠난 뒤(pointerleave)에야 다음 비행
    if (el.matches(':hover')) el.dataset.state = 'rest';
    else delete el.dataset.state;
  }

  document.querySelectorAll<SVGSVGElement>('.flock .crane').forEach((el) => {
    el.addEventListener('pointerenter', () => void fly(el), { passive: true });
    el.addEventListener(
      'pointerleave',
      () => {
        if (el.dataset.state === 'rest') delete el.dataset.state;
      },
      { passive: true },
    );
  });
</script>

<style>
  .flock {
    /* 패널 테두리 선 위에 발이 닿게 — .panel 은 relative, 이 층은 패널 위 0 높이 띠 */
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 0;
    pointer-events: none;
    --crane-size: clamp(2.75rem, 2rem + 1.4vw, 4.25rem);
  }
  .defs {
    position: absolute;
  }
  .crane {
    position: absolute;
    bottom: 0;
    left: var(--x);
    height: calc(var(--crane-size) * var(--h, 1));
    width: auto;
    aspect-ratio: 100 / 128.5;
    overflow: visible;
    pointer-events: auto;
  }
  .crane.right {
    left: auto;
    right: var(--x);
  }
  .crane.flip {
    scale: -1 1;
  }

  /* 자세 전환 — 기본은 서 있는 그림만 */
  .u-land,
  .u-fly {
    display: none;
  }
  .crane[data-state='land'] .u-stand,
  .crane[data-state='fly'] .u-stand {
    display: none;
  }
  .crane[data-state='land'] .u-land {
    display: inline;
  }
  .crane[data-state='fly'] .u-fly {
    display: inline;
    animation: flap 280ms steps(1, end) infinite;
  }
  .crane[data-state='fly'] .u-fly-down {
    animation-delay: -140ms;
  }
  @keyframes flap {
    0% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  /* 먹선 라인아트 — 선 굵기는 화면 px 고정(non-scaling-stroke). viewBox 단위로 두면 4rem 높이에서 0.5px 가 되어
     1x 화면에서 회색으로 번진다. 1px 안팎이면 1x 에서 또렷하고 2x 에서도 가는 먹선으로 남는다 */
  .c-fill,
  .c-line,
  .c-ink,
  .c-leg,
  .c-toe {
    vector-effect: non-scaling-stroke;
  }
  .c-fill {
    fill: var(--crane-body);
    stroke: var(--crane-ink);
    stroke-width: 0.9px;
    stroke-linejoin: round;
  }
  .c-body {
    fill: var(--crane-body);
    stroke: none;
  }
  .c-line {
    fill: none;
    stroke: var(--crane-ink);
    stroke-width: 0.6px;
    stroke-linecap: round;
  }
  .c-ink {
    fill: var(--crane-ink);
    stroke: var(--crane-ink);
    stroke-width: 0.3px;
    stroke-linejoin: round;
  }
  .c-crown {
    fill: var(--crane-crown);
    stroke: none;
  }
  .c-leg {
    fill: none;
    stroke: var(--crane-ink);
    stroke-width: 1px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .c-toe {
    fill: none;
    stroke: var(--crane-ink);
    stroke-width: 0.9px;
    stroke-linecap: round;
  }

  @media (max-width: 40rem) {
    .crane {
      left: var(--xm, var(--x));
    }
    .crane.right {
      left: auto;
      right: var(--xm, var(--x));
    }
  }
</style>
