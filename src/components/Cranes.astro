      </g>
      <g id="crane-wing-down">
        <path class="c-fill" d="M 46 60 C 40 74 50 96 70 112 C 74 102 68 86 62 74 C 60 70 58 66 62 62 Z"></path>
        <path class="c-ink" d="M 70 112 C 72 106 71 98 68 90 L 66 94 L 66 86 L 64 91 L 63 82 L 61 88 C 65 96 68 104 70 112 Z"></path>
        <path class="c-line" d="M 50 68 C 56 80 62 90 68 104"></path>
        <path class="c-line" d="M 54 64 C 58 76 62 84 66 96"></path>
      </g>
      <!-- 나는 몸: 몸통 수평, 목 앞으로, 다리 뒤로 -->
      <g id="crane-flybody">
        <path class="c-leg" d="M 64 72 L 80 79 L 96 82"></path>
        <path class="c-leg" d="M 60 73 L 78 82 L 94 86"></path>
        <path class="c-fill" d="M 30 60 C 36 52 58 51 70 57 C 76 60 78 66 74 70 C 62 76 40 75 30 68 Z"></path>
        <path class="c-ink" d="M 68 56 C 78 55 88 58 93 64 L 91 68 L 89 63 L 88 70 L 86 65 L 83 71 L 81 65 L 78 69 L 77 64 C 74 62 71 60 68 56 Z"></path>
        <path class="c-body" d="M 31 66 C 24 64 16 60 10 57 L 15 51.5 C 20 52 26 55 32 58 L 34 62 Z"></path>
        <path class="c-line" d="M 31 66 C 24 64 16 60 10 57"></path>
        <path class="c-line" d="M 32 58 C 26 55 20 52 15 51.5"></path>
        <path class="c-fill" d="M 9.5 57 C 11 58.8 14.5 58.8 16.5 57 C 18.5 55 18.3 51.5 16 50 C 13.5 48.6 10 49.4 9 52 Z"></path>
        <path class="c-crown" d="M 9.2 51.8 C 11 49 14.5 48.8 16.3 50.5 C 14 50.2 11.5 50.6 9.2 51.8 Z"></path>
