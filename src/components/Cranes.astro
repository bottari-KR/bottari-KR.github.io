---
// 목록 페이지 패널(ListShell .panel) 위에 서 있는 두루미 넷 — 2026-08-28 사용자 요청
// "카테고리·태그·아카이브·문의가 허전하다. 흰 박스 위에 조그맣게 4마리 정도 서 있는 느낌으로".
// 사용자가 준 레퍼런스(Pinterest 핀, 먹선 라인아트 단정학 — 흰 몸 · 검은 날개깃 · 붉은 정수리 · 가는 먹선)는
// 스타일만 빌렸다. 픽셀은 쓰지 않고 SVG 로 직접 그렸다(viewBox 100×128.5, 발끝이 아래 가장자리).
// <defs> 하나에 다리(둘·외발) · 몸통 · 머리(자세 셋: 서서 보기 · 땅 쪼기 · 깃 다듬기)를 두고 <use> 로 조합한다.
// 색은 global.css 의 --crane-* 토큰. 장식이라 aria-hidden, pointer-events 없음.
---

<div class="flock" aria-hidden="true">
  <svg class="defs" width="0" height="0" focusable="false">
    <defs>
      <g id="crane-body">
        <path class="c-fill" d="M 27 68 C 30 56 46 52 60 55 C 74 58 86 64 89 71 C 84 82 68 88 52 86 C 38 84 26 80 27 68 Z"></path>
        <path class="c-ink" d="M 69 59 C 80 57 90 62 95 71 C 94 75 93 78 92 82 L 90.5 76 L 89.5 86 L 87 78 L 86 89 L 83.5 80 L 81.5 89 L 79.5 80 L 77 85 L 76 78 C 73.5 72 70 65 69 59 Z"></path>
        <path class="c-line" d="M 36 62 C 52 57 70 60 82 68"></path>
        <path class="c-line" d="M 42 68 C 54 65 66 67 78 74"></path>
        <path class="c-line" d="M 50 74 C 58 72 68 74 74 80"></path>
        <path class="c-line" d="M 58 80 C 63 79 68 81 71 84"></path>
      </g>
      <g id="crane-legs-2">
        <path class="c-leg" d="M 52 85 L 50 104 L 47 127"></path>
        <path class="c-leg" d="M 60 86 L 62 104 L 64 127"></path>
        <path class="c-toe" d="M 39 127.5 L 49.5 127.5"></path>
        <path class="c-toe" d="M 56 127.5 L 66.5 127.5"></path>
      </g>
      <g id="crane-legs-1">
        <path class="c-leg" d="M 56 86 L 55 106 L 55 127"></path>
        <path class="c-toe" d="M 47 127.5 L 57.5 127.5"></path>
        <path class="c-leg" d="M 61 86 L 69 96 L 61 100"></path>
      </g>
      <g id="crane-head-alert">
        <path class="c-body" d="M 28.3 64.6 C 22 54 24 38 30 26 C 32.5 21 34 16.5 35 12.5 L 41 11 C 40 16 38 21 34.5 26 C 29.5 38 28.5 50 34.3 58.3 L 31 66 Z"></path>
        <path class="c-line" d="M 28.3 64.6 C 22 54 24 38 30 26 C 32.5 21 34 16.5 35 12.5"></path>
        <path class="c-line" d="M 34.3 58.3 C 28.5 50 29.5 38 34.5 26 C 38 21 40 16 41 11"></path>
        <path class="c-fill" d="M 35 12.8 C 37 13.8 40 13.8 42 12.8 C 44 11.8 44.5 8.5 42.5 7 C 40.5 5.6 37 6 35 8.8 Z"></path>
        <path class="c-crown" d="M 35 8.9 C 37 5.9 41 5.5 43 7.4 C 41 7 38 7.6 35 8.9 Z"></path>
        <path class="c-ink" d="M 35 8.8 L 21 13.8 L 35 12.8 Z"></path>
        <circle class="c-ink" cx="38.3" cy="10.2" r="0.8"></circle>
      </g>
      <g id="crane-head-forage">
        <path class="c-body" d="M 28.3 64.6 C 18 62 8 72 6 84 C 5 92 5 100 6 105 L 12 103.5 C 11 96 11 88 12 78 C 14 64 26 56 34.3 58.3 L 31 66 Z"></path>
        <path class="c-line" d="M 28.3 64.6 C 18 62 8 72 6 84 C 5 92 5 100 6 105"></path>
        <path class="c-line" d="M 34.3 58.3 C 26 56 14 64 12 78 C 11 88 11 96 12 103.5"></path>
        <path class="c-fill" d="M 5.5 108.5 C 5 105 6.5 102.8 9.5 102.8 C 12.5 102.8 14.5 105 14 111 L 7.5 113 C 6 111.5 5.5 110 5.5 108.5 Z"></path>
        <path class="c-crown" d="M 11.5 103 C 13.8 104.2 14.8 107.5 14.2 110.5 C 13.8 107.5 13 105 11.5 103 Z"></path>
        <path class="c-ink" d="M 14 111 L 9.8 127 L 7.5 113 Z"></path>
        <circle class="c-ink" cx="9.5" cy="107.5" r="0.8"></circle>
      </g>
      <g id="crane-head-preen">
        <path class="c-body" d="M 28.3 64.6 C 22 52 24 34 36 30 C 46 27 52 30 54 36 L 52 41 C 50 36 46 34 40 36 C 31 40 30 50 34.3 58.3 L 31 66 Z"></path>
        <path class="c-line" d="M 28.3 64.6 C 22 52 24 34 36 30 C 46 27 52 30 54 36"></path>
        <path class="c-line" d="M 34.3 58.3 C 30 50 31 40 40 36 C 46 34 50 36 52 41"></path>
        <path class="c-fill" d="M 52 41 C 51.5 37.5 54 34.5 58 35 C 62 35.5 64.5 39 63.5 44 L 58.5 47.5 C 55 48 52.5 45 52 41 Z"></path>
        <path class="c-crown" d="M 57 34.9 C 61 35 64 38 64 42 C 62.5 39 60 36.5 57 34.9 Z"></path>
        <path class="c-ink" d="M 63.5 44 L 70 57 L 58.5 47.5 Z"></path>
        <circle class="c-ink" cx="59" cy="40" r="0.8"></circle>
      </g>
      <symbol id="crane-alert" viewBox="0 0 100 128.5"><use href="#crane-legs-2"></use><use href="#crane-body"></use><use href="#crane-head-alert"></use></symbol>
      <symbol id="crane-forage" viewBox="0 0 100 128.5"><use href="#crane-legs-2"></use><use href="#crane-body"></use><use href="#crane-head-forage"></use></symbol>
      <symbol id="crane-preen" viewBox="0 0 100 128.5"><use href="#crane-legs-2"></use><use href="#crane-body"></use><use href="#crane-head-preen"></use></symbol>
      <symbol id="crane-oneleg" viewBox="0 0 100 128.5"><use href="#crane-legs-1"></use><use href="#crane-body"></use><use href="#crane-head-alert"></use></symbol>
    </defs>
  </svg>

  <!-- 왼쪽에 셋(쪼기 · 서기 · 깃 다듬기), 오른쪽 끝에 외발로 선 하나(거울) -->
  <svg class="crane" style="left: 1.25rem; --h: 0.86"><use href="#crane-forage"></use></svg>
  <svg class="crane" style="left: 4.75rem; --h: 1"><use href="#crane-alert"></use></svg>
  <svg class="crane" style="left: 8.5rem; --h: 0.92"><use href="#crane-preen"></use></svg>
  <svg class="crane flip" style="right: 2rem; --h: 1.04"><use href="#crane-oneleg"></use></svg>
</div>

<style>
  .flock {
    /* 패널 테두리 선 위에 발이 닿게 — .panel 은 relative, 이 층은 패널 위 0 높이 띠 */
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 0;
    pointer-events: none;
    --crane-size: clamp(2.75rem, 2rem + 1.4vw, 4.25rem);
  }
  .defs {
    position: absolute;
  }
  .crane {
    position: absolute;
    bottom: 0;
    height: calc(var(--crane-size) * var(--h, 1));
    width: auto;
    aspect-ratio: 100 / 128.5;
    overflow: visible;
  }
  .crane.flip {
    transform: scaleX(-1);
  }

  /* 먹선 라인아트 — 선 굵기는 화면 px 고정(non-scaling-stroke). viewBox 단위로 두면 4rem 높이에서 0.5px 가 되어
     1x 화면에서 회색으로 번진다. 1px 안팎이면 1x 에서 또렷하고 2x 에서도 가는 먹선으로 남는다 */
  .c-fill,
  .c-line,
  .c-ink,
  .c-leg,
  .c-toe {
    vector-effect: non-scaling-stroke;
  }
  .c-fill {
    fill: var(--crane-body);
    stroke: var(--crane-ink);
    stroke-width: 0.9px;
    stroke-linejoin: round;
  }
  .c-body {
    fill: var(--crane-body);
    stroke: none;
  }
  .c-line {
    fill: none;
    stroke: var(--crane-ink);
    stroke-width: 0.6px;
    stroke-linecap: round;
  }
  .c-ink {
    fill: var(--crane-ink);
    stroke: var(--crane-ink);
    stroke-width: 0.3px;
    stroke-linejoin: round;
  }
  .c-crown {
    fill: var(--crane-crown);
    stroke: none;
  }
  .c-leg {
    fill: none;
    stroke: var(--crane-ink);
    stroke-width: 1px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .c-toe {
    fill: none;
    stroke: var(--crane-ink);
    stroke-width: 0.9px;
    stroke-linecap: round;
  }

  @media (max-width: 40rem) {
    .crane:nth-of-type(3) {
      left: 7.75rem;
    }
  }
</style>
