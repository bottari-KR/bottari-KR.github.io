---
// 목록 페이지 패널(ListShell .panel) 위에 서 있는 두루미 — 2026-08-28 사용자 요청
// "카테고리·태그·아카이브·문의가 허전하다. 흰 박스 위에 조그맣게 4마리 정도 서 있는 느낌으로".
// 사용자가 준 레퍼런스(Pinterest 핀, 먹선 라인아트 단정학 — 흰 몸 · 검은 날개깃 · 붉은 정수리 · 가는 먹선)는
// 스타일만 빌렸다. 픽셀은 쓰지 않고 SVG 로 직접 그렸다(viewBox 100×128.5, 발끝이 아래 가장자리).
// <defs> 하나에 다리(둘·외발) · 몸통 · 머리(자세 셋: 서서 보기 · 땅 쪼기 · 깃 다듬기) · 날개(위·아래) · 나는 몸을 두고
// <use> 로 조합한다. 색은 global.css 의 --crane-* 토큰. 장식이라 aria-hidden.
// 페이지마다 마릿수·자리·자세가 다르다 — 같은 날 사용자 요청: 카테고리 4(그대로) · 태그 3 · 아카이브 5 · 문의 2, 자리는 전부 다르게.
// x 는 패널 왼쪽(side:'right' 면 오른쪽) 가장자리에서의 거리. 카테고리는 rem(왼쪽 셋 묶음, xm 은 좁은 화면용),
// 나머지는 패널 폭의 % 라 좁은 화면에서도 서로 안 겹친다(두루미 폭 ≤ 3.3rem, 폰 패널 ≈ 22rem).
// 마우스를 올리면(터치는 탭) 날개를 펴고 바라보는 쪽으로 날아갔다가 몇 초 뒤 반대쪽에서 돌아와 제자리에 앉는다 —
// 같은 날 사용자 요청. 아래 <script> 가 WAAPI 로 translate/rotate 를 움직이고 data-state 로 자세(stand/land/fly)를 바꾼다.
// prefers-reduced-motion 이면 날지 않는다.
type Pose = 'alert' | 'forage' | 'preen' | 'oneleg';
interface Crane {
  pose: Pose;
  x: string;
  xm?: string;
  side?: 'right';
  h: number;
  flip?: boolean;
}
const FLOCKS: Record<'categories' | 'tags' | 'archive' | 'contact', Crane[]> = {
  categories: [
    { pose: 'forage', x: '1.25rem', h: 0.86 },
    { pose: 'alert', x: '4.75rem', h: 1 },
    { pose: 'preen', x: '8.5rem', xm: '7.75rem', h: 0.92 },
    { pose: 'oneleg', x: '2rem', side: 'right', h: 1.04, flip: true },
  ],
  tags: [
    { pose: 'preen', x: '9%', h: 0.94 },
    { pose: 'oneleg', x: '41%', h: 1.02, flip: true },
    { pose: 'forage', x: '13%', side: 'right', h: 0.88 },
  ],
  archive: [
    { pose: 'alert', x: '3%', h: 1 },
    { pose: 'forage', x: '18%', h: 0.86, flip: true },
    { pose: 'preen', x: '46%', h: 0.92 },
    { pose: 'oneleg', x: '24%', side: 'right', h: 1.04, flip: true },
    { pose: 'alert', x: '5%', side: 'right', h: 0.9 },
  ],
  contact: [
    { pose: 'oneleg', x: '14%', h: 1 },
    { pose: 'preen', x: '10%', side: 'right', h: 0.9, flip: true },
  ],
};

interface Props {
  flock?: keyof typeof FLOCKS;
}

const { flock = 'categories' } = Astro.props;
const cranes = FLOCKS[flock];
---

<div class="flock" aria-hidden="true">
  <svg class="defs" width="0" height="0" focusable="false">
    <defs>
      <g id="crane-body">
        <path class="c-fill" d="M 27 68 C 30 56 46 52 60 55 C 74 58 86 64 89 71 C 84 82 68 88 52 86 C 38 84 26 80 27 68 Z"></path>
