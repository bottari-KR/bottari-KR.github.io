      </g>
      <!-- 날개: 어깨(46,58) 기준. up = 등 위로 펼침, down = 배 아래로 내림. 끝 1/3 은 검은 깃 -->
      <g id="crane-wing-up">
        <path class="c-fill" d="M 46 58 C 40 44 50 24 70 12 C 74 22 68 38 62 48 C 60 52 58 56 62 59 Z"></path>
        <path class="c-ink" d="M 70 12 C 72 18 71 26 68 34 L 66 30 L 66 38 L 64 33 L 63 42 L 61 36 C 65 28 68 20 70 12 Z"></path>
        <path class="c-line" d="M 50 50 C 56 38 62 28 68 18"></path>
