        <path class="c-body" d="M 28.3 64.6 C 22 52 24 34 36 30 C 46 27 52 30 54 36 L 52 41 C 50 36 46 34 40 36 C 31 40 30 50 34.3 58.3 L 31 66 Z"></path>
        <path class="c-line" d="M 28.3 64.6 C 22 52 24 34 36 30 C 46 27 52 30 54 36"></path>
        <path class="c-line" d="M 34.3 58.3 C 30 50 31 40 40 36 C 46 34 50 36 52 41"></path>
        <path class="c-fill" d="M 52 41 C 51.5 37.5 54 34.5 58 35 C 62 35.5 64.5 39 63.5 44 L 58.5 47.5 C 55 48 52.5 45 52 41 Z"></path>
        <path class="c-crown" d="M 57 34.9 C 61 35 64 38 64 42 C 62.5 39 60 36.5 57 34.9 Z"></path>
