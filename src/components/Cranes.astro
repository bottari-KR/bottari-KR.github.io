        <path class="c-crown" d="M 11.5 103 C 13.8 104.2 14.8 107.5 14.2 110.5 C 13.8 107.5 13 105 11.5 103 Z"></path>
        <path class="c-ink" d="M 14 111 L 9.8 127 L 7.5 113 Z"></path>
