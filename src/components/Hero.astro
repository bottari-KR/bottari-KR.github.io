---
// 홈 히어로 — 헤드라인(SITE.tagline)과 글 목록으로 가는 링크만. 그림·애니메이션 없음(2026-08-28 사용자 결정).
import { SITE } from '../site';

interface Props {
  title?: string;
  cta?: { href: string; label: string };
}

const { title = SITE.tagline, cta = { href: '#posts', label: '글 보기' } } = Astro.props;
---

<section class="hero" aria-label="소개">
  <h1>{title}</h1>
  <p class="actions">
    <a class="cta" href={cta.href}>{cta.label}<span aria-hidden="true"> ↓</span></a>
  </p>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 12vh, 7rem) 3rem;
  }
  h1 {
    font-size: clamp(3rem, 2rem + 5vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .actions {
    margin-top: 1.5rem;
  }
  .cta {
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--fg-faint);
  }
  .cta:hover {
    text-decoration-color: var(--accent);
  }
</style>
