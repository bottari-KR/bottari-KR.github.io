---
// 홈 히어로 — 2026-08-28 사용자 지정 레퍼런스(Behance 122104365 "2022 portfolio" 첫 장)의 구성을 CSS 로 재현한다.
// 밝은 회색 그레인 배경 · 큰 산호색 그러데이션 원 · 원 둘레를 도는 작은 곡선 문구 · 좌하단 대형 헤드라인(두 줄).
// 이미지를 복사하지 않는다 — 원은 radial-gradient, 그레인은 인라인 SVG feTurbulence, 곡선 문구는 SVG textPath.
// 움직임 없음(장식 애니메이션은 두 번 기각됐다).
import { SITE } from '../site';

interface Props {
  title?: string;
  /** 원 둘레를 도는 문구 — 기본은 SITE.heroArc */
  arc?: string;
  cta?: { href: string; label: string };
}

const { title = SITE.tagline, arc = SITE.heroArc, cta = { href: '#posts', label: '글 보기' } } = Astro.props;
// 헤드라인은 어절마다 한 줄 — 레퍼런스의 "DESIGN / PORTFOLIO" 두 줄 쌓기. 텍스트 노드 사이 공백은 접근성 이름에 남는다.
const lines = title.split(' ');
---

<section class="hero grain" aria-label="첫 화면">
  <picture>
    <source srcset="/media/hero-blob-dark.webp" media="(prefers-color-scheme: dark)" />
    <img
      class="blob"
      src="/media/hero-blob.webp"
      alt=""
      width="1200"
      height="1200"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
  <svg class="arc" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <path id="hero-arc" d="M 50 4 A 46 46 0 1 1 49.99 4" fill="none"></path>
    <text>
      <textPath href="#hero-arc" startOffset="1%">{arc}</textPath>
    </text>
  </svg>
  <div class="content">
    <h1>
      {lines.map((line, i) => (
        <>
          {i > 0 && ' '}
          <span class="line">{line}</span>
        </>
      ))}
    </h1>
    <p class="actions">
      <a class="cta" href={cta.href}>{cta.label}<span aria-hidden="true"> ↓</span></a>
    </p>
  </div>
</section>

<style>
  .hero {
    /* 높이가 정해진 컨테이너 — 원·문구 크기를 cqh/cqw 로 히어로 자체에 맞춘다(뷰포트가 아주 길어도 60rem 에서 멈춤) */
    container-type: size;
    position: relative;
    height: clamp(34rem, 100svh, 60rem);
    overflow: hidden;
    isolation: isolate;
    background: var(--hero-bg);
    color: var(--hero-fg);
    /* --blob = 원 이미지 요소의 한 변. 이미지 안에서 보이는 원은 한 변의 약 72%(scripts/render-hero-blob.py 출력) */
    --blob: min(92cqh, 80cqw);
    --blob-x: 46%;
    --blob-y: 58%;
  }

  /* 종이 그레인은 global.css 의 .grain (소개 페이지와 공유) */

  .blob {
    position: absolute;
    z-index: 1;
    left: var(--blob-x);
    top: var(--blob-y);
    width: var(--blob);
    height: auto;
    max-width: none;
    translate: -50% -50%;
    pointer-events: none;
    user-select: none;
    /* 원 자체는 미리 렌더한 WebP(투명 배경, 그레인·비대칭 번짐 포함) — CSS gradient 로는 레퍼런스의 알갱이
       번짐이 안 나와서 사용자가 "흐릿하다"고 두 번 기각했다. 재생성은 scripts/render-hero-blob.py */
  }

  .arc {
    position: absolute;
    z-index: 2;
    left: var(--blob-x);
    top: var(--blob-y);
    width: calc(var(--blob) * 1.1);
    height: auto;
    translate: -50% -50%;
    overflow: visible;
    fill: var(--hero-fg);
    /* 별도 서체 계획(Cheddar Gothic Rough, 산돌구름 구독)은 2026-08-28 사용자가 접었다 — 본문 서체 그대로 */
    font-family: var(--font-display);
    font-size: 3.3px; /* viewBox 단위 — 컨테이너와 같이 커진다. 2026-08-28 사용자 "조금만 키워" — 2.9 에서 */
    font-weight: 500;
    letter-spacing: 0.3px;
    /* 대소문자는 원문 그대로(사용자: "내가 보낸 이대로") */
  }

  .content {
    position: absolute;
    z-index: 4;
    left: var(--hero-inset);
    right: var(--hero-inset);
    bottom: clamp(2rem, 7cqh, 4.5rem);
  }

  h1 {
    font-size: clamp(3.5rem, 12.5cqw, 11.5rem); /* 2026-08-28 사용자 "조금만 줄여" — 13.5cqw/12.5rem 에서 */
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.92;
    text-transform: uppercase; /* 레퍼런스는 전부 대문자. 원문(SITE.tagline)은 그대로 두고 표시만 */
    text-wrap: initial;
  }
  .line {
    display: block;
  }

  .actions {
    margin-top: 1.5rem;
    font-size: var(--text-sm);
  }
  .cta {
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-color: color-mix(in srgb, var(--hero-fg) 45%, transparent);
  }
  .cta:hover {
    color: var(--hero-fg);
    text-decoration-color: var(--hero-blob);
  }
  .hero :focus-visible {
    outline-color: var(--hero-fg);
  }

  /* 좁은 화면 — 원은 가로 기준으로 키우고 살짝 위로, 헤드라인은 가로폭에 맞춘다 */
  @media (max-width: 40rem) {
    .hero {
      height: clamp(30rem, 100svh, 46rem);
      --blob: min(72cqh, 118cqw);
      --blob-y: 50%;
      --blob-x: 52%;
    }
    .arc {
      font-size: 3.7px;
    }
    h1 {
      font-size: clamp(3.25rem, 17cqw, 5.25rem);
    }
  }
</style>
