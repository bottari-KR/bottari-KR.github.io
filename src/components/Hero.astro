---
// 홈 히어로 — 왼쪽에 사이트 문구, 오른쪽에 유리 바구니 애니메이션(Bucket). 밝은 배경, 헤더는 일반 헤더.
import Bucket, { type Chip } from './Bucket.astro';
import { SITE } from '../site';

interface Props {
  title?: string;
  cta?: { href: string; label: string };
  chips?: Chip[];
}

// 카드 문구는 원본 데모 그대로 둔 자리표시 — 사용자가 보고 정한다(지어내지 않는다).
const PLACEHOLDER_CHIPS: Chip[] = [
  { title: 'Production Ready', description: 'Fully type-safe and tested', icon: 'security-check' },
  { title: 'Fluid Motion', description: '60fps optimizations built-in', icon: 'zap' },
  { title: 'Accessible', description: 'Works perfectly for everyone', icon: 'user-story' },
  { title: 'Modern Design', description: 'Crafted for high-end feel', icon: 'sparkles' },
];

const { title = SITE.description, cta = { href: '#posts', label: '글 보기' }, chips = PLACEHOLDER_CHIPS } = Astro.props;
---

<section class="hero" aria-label="소개">
  <div class="copy">
    <h1>{title}</h1>
    <p class="actions">
      <a class="cta" href={cta.href}>{cta.label}<span aria-hidden="true"> ↓</span></a>
    </p>
  </div>
  <div class="art">
    <Bucket chips={chips} />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem 3rem;
    align-items: center;
    padding-block: 2.5rem 3rem;
  }
  .copy h1 {
    font-size: var(--text-2xl);
  }
  .actions {
    margin-top: 1.25rem;
  }
  .cta {
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--fg-faint);
  }
  .cta:hover {
    text-decoration-color: var(--accent);
  }
  .art {
    /* 유리 패널이 흰 배경에서 읽히도록 뒤에 아주 옅은 색을 깐다 */
    background: radial-gradient(60% 70% at 50% 45%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 72%);
    padding-block: 1rem;
  }

  @media (min-width: 64rem) {
    .hero {
      /* 문구 : 일러스트 ≈ 46 : 54 — 60rem 컬럼 안에서 제목이 두세 줄로 떨어지게 */
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      padding-block: 3rem 4rem;
    }
  }
</style>
