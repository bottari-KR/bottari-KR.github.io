---
// 홈 히어로 — 화면을 채우는 숲 영상(포스터 폴백) 위에 사이트 문구.
// 영상 URL 은 HTML 에 두지 않는다 — `autoplay`/`<source>`/`poster` 가 있으면 스크립트가 떼어내기 전에 브라우저가
// 이미 내려받기 시작한다(실측). 조건을 통과할 때만 스크립트가 src 를 붙이고 재생한다(무음이라 자동재생 허용).
import { SITE } from '../site';

interface Props {
  title?: string;
  cta?: { href: string; label: string };
}

const { title = SITE.description, cta = { href: '#posts', label: '글 보기' } } = Astro.props;
const VIDEO_SRC = '/media/hero-forest.mp4';
---

<section class="hero" aria-label="소개">
  <div class="media" aria-hidden="true">
    <img
      class="poster"
      src="/media/hero-forest-768.jpg"
      srcset="/media/hero-forest-768.jpg 768w, /media/hero-forest-1280.jpg 1280w"
      sizes="100vw"
      alt=""
      decoding="async"
      fetchpriority="high"
    />
    <video class="video" muted loop playsinline preload="none" data-src={VIDEO_SRC}></video>
  </div>
  <div class="veil"></div>
  <div class="content">
    <h1>{title}</h1>
    <p class="actions">
      <a class="cta" href={cta.href}>{cta.label}<span aria-hidden="true"> ↓</span></a>
      <button class="motion" type="button" aria-pressed="false" hidden>영상 멈춤</button>
    </p>
  </div>
</section>

<script>
  // 영상을 내려받지 않을 조건 — 움직임 줄이기 · 데이터 절약 · 좁거나 낮은 화면(폰). 포스터 <img> 가 그대로 남는다.
  const video = document.querySelector<HTMLVideoElement>('.hero .video');
  const toggle = document.querySelector<HTMLButtonElement>('.hero .motion');
  if (video) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const small = window.matchMedia('(max-width: 40rem), (max-height: 30rem)').matches;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    const src = video.dataset.src;
    if (reduce || small || saveData || !src) {
      video.remove();
      toggle?.remove();
    } else {
      // 리스너를 src 지정보다 먼저 건다 — 캐시된 영상은 canplay 가 즉시 올 수 있다.
      const show = () => video.classList.add('ready');
      video.addEventListener('canplay', show, { once: true });
      video.src = src;
      video.play().catch(() => {
        // 자동재생이 막히면 포스터만 남긴다
        video.remove();
        toggle?.remove();
      });
      if (video.readyState >= HTMLMediaElement.HAVE_FUTURE_DATA) show();

      // WCAG 2.2.2 — 5초 넘게 자동으로 움직이는 콘텐츠는 멈출 수 있어야 한다
      if (toggle) {
        toggle.hidden = false;
        toggle.addEventListener('click', () => {
          const paused = video.paused;
          if (paused) video.play().catch(() => {});
          else video.pause();
          toggle.setAttribute('aria-pressed', String(!paused));
          toggle.textContent = paused ? '영상 멈춤' : '영상 재생';
        });
      }
    }
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 88vh;
    min-height: 88svh;
    display: grid;
    /* 컬럼을 명시하지 않으면 keep-all 제목의 max-content 폭으로 늘어나 모바일에서 넘친다 */
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
    color: #fff;
    isolation: isolate;
    overflow: hidden;
    /* 헤더가 위에 얹히므로 헤더 높이만큼 위 여백(모바일은 nav 가 두 줄) */
    padding-top: 8rem;
  }
  .media,
  .veil {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .poster,
  .video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video {
    opacity: 0;
    transition: opacity 600ms ease-out;
  }
  .video.ready {
    opacity: 1;
  }
  /* 베일은 글자가 놓이는 왼쪽 아래와 nav 가 놓이는 위쪽에만 — 오른쪽 위 절반은 숲이 그대로 산다 */
  .veil {
    background:
      linear-gradient(to bottom, rgb(0 0 0 / 0.5), transparent 38%),
      linear-gradient(to right, rgb(0 0 0 / 0.5), rgb(0 0 0 / 0.18) 55%, transparent 85%),
      linear-gradient(to top, rgb(0 0 0 / 0.35), transparent 45%);
  }
  .content {
    width: 100%;
    min-width: 0;
    /* 헤더 오버레이와 같은 왼쪽 선 — 60rem 컬럼에 묶지 않는다 */
    padding-inline: var(--hero-inset);
    padding-bottom: clamp(2.5rem, 8vh, 5rem);
  }
  h1 {
    font-size: clamp(2rem, 1.25rem + 4vw, 4.5rem);
    max-width: 22ch;
    letter-spacing: -0.02em;
    text-shadow:
      0 1px 2px rgb(0 0 0 / 0.45),
      0 2px 28px rgb(0 0 0 / 0.35);
  }
  .actions {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    font-size: var(--text-base);
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.45);
  }
  /* 사이트의 링크 언어(밑줄)를 그대로 — 버튼은 이 사이트에 없다 */
  .cta {
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-color: rgb(255 255 255 / 0.6);
  }
  .cta:hover {
    color: #fff;
    text-decoration-color: #fff;
  }
  .cta:focus-visible,
  .motion:focus-visible {
    outline-color: #fff;
  }
  .motion {
    font: inherit;
    font-size: var(--text-sm);
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    opacity: 0.8;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-color: rgb(255 255 255 / 0.4);
  }
  .motion:hover {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .video {
      display: none;
    }
  }
</style>
