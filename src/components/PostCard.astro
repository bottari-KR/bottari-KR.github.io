---
// 글 카드 — 2026-10-26 사용자 결정: "루비님같은 느낌으로 똑같이". ruby-kim.github.io(Hexo Matery + my.css) 카드를 실측해 옮겼다.
// 위 = 커버 그림 220px + 아래로 어두워지는 그러데이션 + 그 위에 카테고리(책갈피·이모지)와 제목(2줄 자름).
// 아래 = 요약 2줄 · 날짜(시계) · 파란 태그 칩. hover = 카드 5px 떠오름 + 그림 1.04배.
// 등장 모션 = AOS zoom-in 과 같은 규칙(아래 <script>·.item 스타일). 커버가 없으면 사이트 기본 공유 카드(SITE.ogImage).
import { tagHref } from '../lib/posts';
import { SITE, CATEGORY_EMOJI, type Category } from '../site';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  categories: readonly string[];
  tags?: readonly string[];
  cover?: string;
  headingLevel?: 'h2' | 'h3';
}

const { href, title, description, pubDate, categories, tags = [], cover = '', headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const img = cover || SITE.ogImage;
const iso = pubDate.toISOString().slice(0, 10);
const label = categories.map((c) => `${CATEGORY_EMOJI[c as Category] ?? ''} ${c}`.trim()).join(' · ');
---

<div class="item" data-reveal>
  <article class="card">
    <a class="img-link" href={href}>
      <div class="img-wrap">
        <img class="img" src={img} alt="" width="1600" height="900" loading="lazy" decoding="async" />
        <div class="overlay" aria-hidden="true"></div>
        <div class="meta">
          <span class="cat">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4.5L6 21z" fill="currentColor" /></svg>
            {label}
          </span>
          <Heading class="title">{title}</Heading>
        </div>
      </div>
    </a>
    <div class="content">
      <p class="summary">{description}</p>
      <div class="info">
        <time class="date" datetime={iso}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8" />
            <path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          {iso}
        </time>
        {
          tags.length > 0 && (
            <ul class="chips">
              {tags.map((t) => (
                <li>
                  <a href={tagHref(t)}>{t}</a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </article>
</div>

<script>
  // ruby-kim 홈의 AOS(zoom-in · once:false · mirror:false · offset 120) 와 같은 규칙 —
  // 카드 위쪽이 화면 아래 120px 선을 넘어 들어오면 나타나고, 다시 그 선 아래로 내려가면(위로 스크롤) 숨겨져 다음에 또 나타난다.
  // 지나쳐 위로 올라간 카드는 그대로 둔다. 움직임 줄이기 설정이면 처음부터 다 보인다.
  const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (items.length > 0 && !reduce && 'IntersectionObserver' in window) {
    const OFFSET = 120;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) e.target.classList.add('in');
          else if (e.boundingClientRect.top > innerHeight - OFFSET) e.target.classList.remove('in');
        }
      },
      { rootMargin: `0px 0px -${OFFSET}px 0px` },
    );
    items.forEach((el) => io.observe(el));
  } else {
    items.forEach((el) => el.classList.add('in'));
  }
</script>

<style>
  /* 등장 모션 — AOS zoom-in 실측: scale(.6)·opacity 0 → 1, 700ms, 나타날 때만 100ms 지연, ease-in-out-sine.
     JS 가 도는 문서(html.js)에서만 처음에 숨긴다. hover 변형은 안쪽 .card 라 서로 안 겹친다 */
  :global(html.js) .item {
    opacity: 0;
    transform: scale(0.6);
    transition-property: opacity, transform;
    transition-duration: 0.7s;
    transition-timing-function: cubic-bezier(0.445, 0.05, 0.55, 0.95);
  }
  :global(html.js) .item.in {
    opacity: 1;
    transform: none;
    transition-delay: 0.1s;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .item {
      opacity: 1;
      transform: none;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--card-shadow);
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .card:hover {
    transform: translateY(-5px);
    box-shadow: var(--card-shadow-hover);
  }

  .img-link,
  .img-link:hover {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .img-wrap {
    position: relative;
    overflow: hidden;
    background: var(--card-img-bg);
  }
  .img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .card:hover .img {
    transform: scale(1.04);
  }
  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.08) 0%, rgb(0 0 0 / 0.55) 100%);
    pointer-events: none;
  }
  .meta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1rem 1.1rem;
    color: #fff;
  }
  .cat {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-bottom: 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.75);
  }
  .cat svg {
    width: 0.65rem;
    height: 0.65rem;
  }
  .title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: #fff;
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.35);
    text-wrap: initial;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 16px 12px;
  }
  .summary {
    font-size: 0.86rem;
    line-height: 1.65;
    color: var(--card-summary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .info {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px;
  }
  .date {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: var(--card-date);
    white-space: nowrap;
  }
  .date svg {
    width: 0.85rem;
    height: 0.85rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    list-style: none;
  }
  .chips a {
    display: inline-block;
    height: 22px;
    line-height: 22px;
    padding: 0 8px;
    border-radius: 6px;
    background: var(--chip-bg);
    color: var(--chip-fg);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.025em;
    text-decoration: none;
    transition: opacity 0.18s, transform 0.18s;
  }
  .chips a:hover {
    opacity: 0.82;
    transform: translateY(-1px);
    color: var(--chip-fg);
    text-decoration: none;
  }
</style>
