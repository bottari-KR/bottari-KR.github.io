---
// 목록 페이지 공통 틀(카테고리·태그·아카이브·문의와 그 하위 페이지) — 2026-08-28 사용자 결정:
// 구조는 ruby-kim.github.io(가운데 제목 띠 + 그 아래 흰 패널), 생김새는 홈과 같은 종이(--hero-*) + 그레인 + 산호색 원.
// Layout 은 hero={true} 로 불러 헤더가 띠 위에 얹히고 main 에 wrap 이 없다 — 패널이 스스로 폭을 잡는다.
interface Props {
  title: string;
  /** 제목 아래 한 줄 — "3개 분류", "12편" 등 */
  sub?: string;
  /** 패널 최대 폭. 기본 72rem(아카이브·태그 격자), narrow 는 60rem(문의) */
  width?: 'wide' | 'narrow';
}

const { title, sub, width = 'wide' } = Astro.props;
---

<div class="shell grain">
  <header class="band">
    <picture class="blob-wrap">
      <source srcset="/media/hero-blob-dark.webp" media="(prefers-color-scheme: dark)" />
      <img class="blob" src="/media/hero-blob.webp" alt="" width="1200" height="1200" decoding="async" />
    </picture>
    <div class="band-text">
      <h1>{title}</h1>
      {sub && <p class="sub">{sub}</p>}
    </div>
  </header>

  <div class:list={['panel', width]}>
    <slot />
  </div>
</div>

<style>
  .shell {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--hero-bg);
    color: var(--hero-fg);
    padding-bottom: clamp(3rem, 8vh, 6rem);
  }

  .band {
    position: relative;
    text-align: center;
    /* 위는 얹힌 헤더(≈5rem) 아래에서 시작 */
    padding: clamp(8rem, 22vh, 12rem) var(--hero-inset) clamp(5rem, 12vh, 8rem);
    /* 2026-08-28 사용자: 원만 오른쪽에 있으니 심심하다 → 사용자가 준 목판화풍 그림(해는 지움, scripts/prepare-band-fuji.py)을
       띠 배경으로 깔고, 산호색 원이 그 해 자리에 앉는다. 위·아래는 종이색으로 녹여 제목과 패널이 읽히게 한다. */
    background-image:
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--hero-bg) 55%, transparent) 0%,
        color-mix(in srgb, var(--hero-bg) 20%, transparent) 35%,
        color-mix(in srgb, var(--hero-bg) 35%, transparent) 70%,
        var(--hero-bg) 100%
      ),
      url('/media/band-fuji.webp');
    background-size: cover;
    background-position: center 38%;
  }
  .band-text {
    position: relative;
    z-index: 1;
  }
  /* 제목 뒤 종이색 무리 — 그림 위에서도 글자가 읽히게 */
  .band-text::before {
    content: '';
    position: absolute;
    inset: -3rem -6rem;
    z-index: -1;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--hero-bg) 80%, transparent) 0%,
      color-mix(in srgb, var(--hero-bg) 50%, transparent) 45%,
      transparent 75%
    );
    pointer-events: none;
  }
  h1 {
    font-size: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .sub {
    margin-top: 1rem;
    font-size: var(--text-base);
    color: var(--hero-fg-muted);
  }

  /* 산호색 원 = 그림의 해 자리(오른쪽 위, 산 정상 옆). 헤더 글자(맨 위 ≈5rem)에는 안 닿게 */
  .blob-wrap {
    position: absolute;
    z-index: 0;
    right: 14%;
    top: 34%;
    width: min(16vw, 12rem);
    aspect-ratio: 1;
    translate: 50% -50%;
    pointer-events: none;
  }
  .blob {
    width: 100%;
    height: auto;
    max-width: none;
    user-select: none;
  }

  .panel {
    position: relative;
    z-index: 1;
    margin-inline: auto;
    width: calc(100% - 2 * var(--hero-inset));
    max-width: 72rem;
    background: var(--panel-bg);
    color: var(--fg);
    border: 1px solid var(--panel-rule);
    border-radius: 14px;
    padding: clamp(1.5rem, 4vw, 3rem);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 12px 32px -16px rgb(0 0 0 / 0.18);
  }
  .panel.narrow {
    max-width: 60rem;
  }

  @media (max-width: 40rem) {
    .band {
      padding-top: clamp(9rem, 24vh, 11rem);
    }
    .blob-wrap {
      width: 30vw;
      right: 12%;
      top: 38%;
    }
    .panel {
      border-radius: 10px;
    }
  }
</style>
