---
// "Bucket" — 유리 바구니 안으로 카드(chip)가 하나씩 떨어지는 일러스트.
// 원본은 21st.dev 계열 React 컴포넌트(motion/react + shadcn + hugeicons). SVG 마크업은 그대로 옮기고,
// 카드 순환 애니메이션은 CSS 키프레임으로 바꿨다 — React·Tailwind·motion 없이 같은 그림.
// 카드 n개가 2초 간격으로 위에서 들어와(0.5s) 잠시 머문 뒤 아래 바구니 속으로 떨어진다(0.8s, 앞판이 가린다).
import { ICONS, type IconName } from './icons';

export interface Chip {
  title: string;
  description: string;
  icon: IconName;
}

interface Props {
  chips: Chip[];
  /** 카드 하나가 머무는 간격(초). 원본 2초 */
  step?: number;
}

const { chips, step = 2 } = Astro.props;
const n = Math.max(chips.length, 1);
const cycle = n * step;
const pct = (sec: number) => ((sec / cycle) * 100).toFixed(3);
// 한 카드의 타임라인(사이클 대비 %): 0 → 등장 완료(0.5s) → 머묾(step) → 낙하 완료(step+0.8s) → 숨김
// 카드의 기준점은 바구니 입구 바로 위(frame 상단) — 원본의 paddingBottom:65% 트릭이 만드는 위치와 같다.
const keyframes = `
@keyframes bucket-chip {
  0% { transform: translate(-50%, calc(-50% + var(--y-in))) scale(0.8); opacity: 0; animation-timing-function: cubic-bezier(0.455, 0.03, 0.515, 0.955); }
  ${pct(0.5)}% { transform: translate(-50%, -50%) scale(var(--s)); opacity: 1; animation-timing-function: linear; }
  ${pct(step)}% { transform: translate(-50%, -50%) scale(var(--s)); opacity: 1; animation-timing-function: cubic-bezier(0.455, 0.03, 0.515, 0.955); }
  ${pct(step + 0.8)}% { transform: translate(-50%, calc(-50% + var(--y-out))) scale(0.8); opacity: 1; }
  ${pct(step + 0.81)}% { opacity: 0; }
  100% { transform: translate(-50%, calc(-50% + var(--y-in))) scale(0.8); opacity: 0; }
}`;
