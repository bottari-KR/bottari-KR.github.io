<style>
  .bucket {
    width: 100%;
    display: flex;
    justify-content: center;
    --s: 1.25;
    --y-in: -100px;
    --y-out: 130px;
  }
  .frame {
    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: 655px;
    aspect-ratio: 655 / 352;
  }
  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .layer.back {
    z-index: 0;
  }
  .layer.front {
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
    transform: translate3d(0, 0, 0);
  }
  .fill-card {
    fill: var(--bg);
  }

  .chips {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .chip {
    position: absolute;
    left: 50%;
    top: 5%;
    width: 240px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--rule);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
    transform-origin: bottom center;
    transform: translate(-50%, calc(-50% + var(--y-in))) scale(0.8);
    opacity: 0;
    animation: bucket-chip var(--cycle) infinite both;
    animation-delay: calc(var(--i) * var(--step));
    text-align: left;
  }
  .chip-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fg-muted) 10%, transparent);
    color: var(--fg-muted);
  }
  .chip-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    line-height: 1.2;
  }
  .chip-text strong {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--fg);
  }
  .chip-text small {
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  @media (max-width: 40rem) {
    .bucket {
      --s: 1;
      --y-in: -70px;
      --y-out: 100px;
    }
  }

  /* 움직임 줄이기 — 첫 카드만 제자리에 보이고 순환하지 않는다 */
  @media (prefers-reduced-motion: reduce) {
    .chip {
      animation: none;
    }
    .chip[style='--i: 0;'] {
      opacity: 1;
      transform: translate(-50%, -50%) scale(var(--s));
    }
  }
</style>
